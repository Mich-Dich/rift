// Registry of every diagnostic the compiler can emit.
//
//   RIFT_DIAG(code, severity, title)
//
// Rules:
//   * Codes are never reused or renumbered once released; retire a code by leaving it here
//     with a "(retired)" title.
//   * Ranges:  E0xxx driver / I/O      E1xxx lexer      E2xxx parser (M2)
//              E3xxx names / modules    E4xxx types      E5xxx ownership / borrows
//              Wxxxx warnings, same ranges.
//   * The title is what `riftc explain <code>` prints. The message at the report site can be
//     more specific.

#ifndef RIFT_DIAG
#error "define RIFT_DIAG(code, severity, title) before including diagnostic_codes.def"
#endif

// --- driver ---------------------------------------------------------------------------------
RIFT_DIAG(E0001, error,   "cannot read source file")
RIFT_DIAG(E0002, error,   "unsupported source file extension (expected .rifts or .rifth)")

// --- lexer ----------------------------------------------------------------------------------
RIFT_DIAG(E1001, error,   "invalid character in source")
RIFT_DIAG(E1002, error,   "unterminated block comment")
RIFT_DIAG(E1003, error,   "unterminated string literal")
RIFT_DIAG(E1004, error,   "unterminated character literal")
RIFT_DIAG(E1005, error,   "empty character literal")
RIFT_DIAG(E1006, error,   "character literal contains more than one character")
RIFT_DIAG(E1007, error,   "unknown escape sequence")
RIFT_DIAG(E1008, error,   "invalid unicode escape")
RIFT_DIAG(E1009, error,   "missing digits after integer base prefix")
RIFT_DIAG(E1010, error,   "invalid digit for the literal's base")
RIFT_DIAG(E1011, error,   "invalid literal suffix")
RIFT_DIAG(E1012, error,   "integer literal is too large")
RIFT_DIAG(E1013, error,   "float suffix on an integer literal")
RIFT_DIAG(E1014, error,   "missing digits in float exponent")
RIFT_DIAG(E1015, error,   "source is not valid UTF-8")

// --- parser ---------------------------------------------------------------------------------
RIFT_DIAG(E2001, error,   "unexpected token")
RIFT_DIAG(E2002, error,   "expected an expression")
RIFT_DIAG(E2003, error,   "expected a type")
RIFT_DIAG(E2004, error,   "expected a declaration")
RIFT_DIAG(E2005, error,   "braces are required around this body")
RIFT_DIAG(E2006, error,   "assignment is a statement, not an expression")
RIFT_DIAG(E2007, error,   "Rift has no '++' or '--' operator")
RIFT_DIAG(E2008, error,   "comparison and range operators cannot be chained")
RIFT_DIAG(E2009, error,   "no ';' after a closing '}'")
RIFT_DIAG(E2010, error,   "variable declared without an initializer")
RIFT_DIAG(E2011, error,   "variables are initialized with '='")
RIFT_DIAG(E2012, error,   "file-scope variable needs 'static' or 'compile_time'")
RIFT_DIAG(E2013, error,   "out-of-line definitions are not allowed")
RIFT_DIAG(E2014, error,   "match arm must end with ','")
RIFT_DIAG(E2015, error,   "C-style 'for' loops do not exist")
RIFT_DIAG(E2016, error,   "unclosed delimiter")
RIFT_DIAG(E2017, error,   "struct construction must name its fields")
RIFT_DIAG(E2018, error,   "'run_time' on its own is the default and is not written")
RIFT_DIAG(E2019, error,   "keyword removed from the language")
RIFT_DIAG(E2020, error,   "'if' used as a value needs an 'else' branch")
RIFT_DIAG(E2021, error,   "not allowed in a struct")
RIFT_DIAG(E2022, error,   "structs cannot have a destructor")
RIFT_DIAG(E2023, error,   "'virtual' and 'override' cannot be combined")
RIFT_DIAG(E2024, error,   "default arguments are not allowed")
RIFT_DIAG(E2025, error,   "'auto' is not allowed in function signatures")
RIFT_DIAG(E2026, error,   "lambda captures must be named")
RIFT_DIAG(E2027, error,   "enum needs an underlying tag type")
RIFT_DIAG(E2028, error,   "interface methods cannot have a body")
RIFT_DIAG(E2029, error,   "'_' can only be used in patterns and in '_ = expr;'")

// --- modules and names ----------------------------------------------------------------------
RIFT_DIAG(E3001, error,   "cannot find module")
RIFT_DIAG(E3002, error,   "import cycle")
RIFT_DIAG(E3003, error,   "module has no header and cannot be imported")
RIFT_DIAG(E3004, error,   "a module does not import itself")
RIFT_DIAG(E3010, error,   "defined more than once")
RIFT_DIAG(E3011, error,   "headers never contain function bodies")
RIFT_DIAG(E3012, error,   "private items do not belong in a header")
RIFT_DIAG(E3013, error,   "declared but never defined")
RIFT_DIAG(E3014, error,   "definition does not match the header declaration")
RIFT_DIAG(E3015, error,   "public member is not declared in the header")
RIFT_DIAG(E3016, error,   "a struct's source block cannot add fields")
RIFT_DIAG(E3017, error,   "item not declared in the header must be 'private'")
RIFT_DIAG(E3018, error,   "enums and interfaces are complete in the header")
RIFT_DIAG(E3020, error,   "cannot find name")
RIFT_DIAG(E3021, error,   "cannot find type")
RIFT_DIAG(E3022, error,   "wrong kind of name (type, value or module)")
RIFT_DIAG(E3023, error,   "module is not imported")
RIFT_DIAG(E3024, error,   "item is private")
RIFT_DIAG(E3025, error,   "no such member or alternative")
RIFT_DIAG(E3026, error,   "members are accessed through 'this.'")
RIFT_DIAG(E3027, error,   "'this' is only available in non-static methods")
RIFT_DIAG(E3028, error,   "name already declared in this function (no shadowing)")
RIFT_DIAG(E3030, error,   "'break' or 'continue' outside a loop")
RIFT_DIAG(E3031, error,   "'mut' marks call arguments and match subjects only")
RIFT_DIAG(E3032, error,   "only local variables and by-value parameters can be moved")
RIFT_DIAG(E3033, error,   "no such field")
RIFT_DIAG(E3034, error,   "field given more than once")
RIFT_DIAG(E3035, error,   "field without a default is missing")
RIFT_DIAG(E3036, error,   "private field set outside its module")
RIFT_DIAG(E3037, error,   "enum alternative used with the wrong payload")
RIFT_DIAG(E3038, error,   "only static methods can be named through the type")
RIFT_DIAG(E3040, error,   "base class is not open")
RIFT_DIAG(E3041, error,   "a class has at most one base class, listed first")
RIFT_DIAG(E3042, error,   "'virtual' and 'abstract' need an open class")
RIFT_DIAG(E3043, error,   "'override' does not match a base method")
RIFT_DIAG(E3044, error,   "method matches a base method but is not marked 'override'")
RIFT_DIAG(E3045, error,   "interface or abstract method is not implemented")
RIFT_DIAG(E3046, error,   "invalid base type")
RIFT_DIAG(E3047, error,   "not a base class of this class")
RIFT_DIAG(E3048, error,   "'abstract' methods are 'virtual' and have no body")
RIFT_DIAG(E3049, error,   "destructor name does not match the class")
RIFT_DIAG(E3050, error,   "lambda uses a local it does not capture")

// --- types ----------------------------------------------------------------------------------
RIFT_DIAG(E4001, error,   "value has no type from context")
RIFT_DIAG(E4002, error,   "literal does not fit in its type")
RIFT_DIAG(E4003, error,   "an integer literal never becomes a float")
RIFT_DIAG(E4010, error,   "mismatched types")
RIFT_DIAG(E4011, error,   "operands have different types")
RIFT_DIAG(E4012, error,   "type does not convert to bool in a condition")
RIFT_DIAG(E4013, error,   "operator does not apply to this type")
RIFT_DIAG(E4014, error,   "type has no operator==")
RIFT_DIAG(E4015, error,   "unsigned values cannot be negated")
RIFT_DIAG(E4020, error,   "value is not mutable")
RIFT_DIAG(E4021, error,   "'this' cannot change in a non-mut method")
RIFT_DIAG(E4022, error,   "mut method called on an immutable value")
RIFT_DIAG(E4023, error,   "mutable reference argument needs 'mut' at the call site")
RIFT_DIAG(E4024, error,   "'mut' at the call site needs a mutable reference parameter")
RIFT_DIAG(E4025, error,   "cannot assign to this expression")
RIFT_DIAG(E4030, error,   "wrong number of arguments")
RIFT_DIAG(E4031, error,   "ambiguous call")
RIFT_DIAG(E4032, error,   "no overload matches the arguments")
RIFT_DIAG(E4033, error,   "not a function")
RIFT_DIAG(E4040, error,   "'return' needs a value")
RIFT_DIAG(E4041, error,   "void function returns a value")
RIFT_DIAG(E4042, error,   "function may end without returning a value")
RIFT_DIAG(E4043, error,   "function bodies return with 'return'")
RIFT_DIAG(E4050, error,   "branches have different types")
