RIFT_DIAG(E4061, error,   "pattern does not match the type of the match subject")
RIFT_DIAG(E4070, error,   "no such field or method")
RIFT_DIAG(E4071, error,   "member is private")
RIFT_DIAG(E4073, error,   "method used without calling it")
RIFT_DIAG(E4074, error,   "pointer members are accessed with '->'")
RIFT_DIAG(E4080, error,   "shift or bit index out of range")
RIFT_DIAG(E4090, error,   "cast<T> may lose data")
RIFT_DIAG(E4091, error,   "cast does not apply to these types")
RIFT_DIAG(E4092, error,   "unknown cast kind")
RIFT_DIAG(E4100, error,   "raw pointer use requires 'unsafe'")
RIFT_DIAG(E4101, error,   "call to an unsafe function requires 'unsafe'")
RIFT_DIAG(E4102, error,   "access to a 'static mut' requires 'unsafe'")
RIFT_DIAG(E4103, error,   "cast::reinterpret requires 'unsafe'")
RIFT_DIAG(E4110, error,   "invalid return type for main")
RIFT_DIAG(E4111, error,   "invalid parameters for main")
RIFT_DIAG(E4120, error,   "compile_time code calls a run-time function")
RIFT_DIAG(E4130, error,   "enum tag type must be an integer type")
RIFT_DIAG(E4140, error,   "type has no default value")
RIFT_DIAG(E4150, error,   "result must be used")
RIFT_DIAG(E4160, error,   "cannot deduce template argument")

RIFT_DIAG(W1001, warning, "'/*' inside a block comment (block comments do not nest)")
RIFT_DIAG(W4001, warning, "unreachable match arm")
RIFT_DIAG(W4002, warning, "implicit allocation of std::string from a string literal")
