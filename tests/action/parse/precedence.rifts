// RUN: riftc parse %s
// Operator precedence and associativity (spec 16). Bit operators bind tighter than comparisons.
void f() {
    _ = a + b * c - d;
    _ = a - b - c;
    _ = flags & mask == 0;
    _ = a | b ^ c & d;
    _ = x << 2 + 1;
    _ = a < b && c >= d || !e;
    _ = -a * ~b;
    _ = *p + &q;
    _ = 0..n + 1;
    _ = a +% b *% c -% d;
    _ = f(x)?.g[i].h;
    _ = move list;
    _ = (a + b) * c;
    _ = a <=> b;
}
