// feature 01/16: every operator and punctuation token.
// STOP-AFTER: parse   (syntax test: names are not declared)
void operators(mut u32 x, u32 b, u32 c, u32 d, u32 e, u32 f, u32 g, std::raw_ptr<point> p) {
    u32 a = b + c - d * e / f % g;
    u32 h = b +% c -% d *% e;
    u32 i = b & c | d ^ ~e;
    u32 j = b << 2 >> 1;
    bool k = !(a == b) && (a != b) || (a < b) && (a <= b) && (a > b) && (a >= b);
    std::ordering l = a <=> b;
    x += 1; x -= 1; x *= 2; x /= 2; x %= 3;
    x &= 1; x |= 2; x ^= 3; x <<= 1; x >>= 1;
    x +%= 1; x -%= 1; x *%= 2;
    for (usize n : 0..10) { }
    for (u8 byte : 0..=255) { }
    auto lambda = [](u32 y) -> u32 { return y; };
    u32 m = match (v) { std::ok(y) => y, _ => 0, };
    u32 o = parse()?;
    unsafe { _ = p->field; }
    std::darray<std::darray<u32>> nested = default;
}
