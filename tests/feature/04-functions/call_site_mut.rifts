// feature 04: 'mut' at the call site marks a mutable reference argument; nowhere else.
import std;
void bump(mut u32& x) { x += 1; }

void calls() {
    mut u32 counter = 0;
    bump(mut counter);
    match (mut counter) {
        _ => 0,
    }
    u32 copy = mut counter;                  //~ error[E3031]
    std::raw_ptr<mut u32> p = mut &counter;  // address-of-mut is fine
}
