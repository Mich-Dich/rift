// feature 11: std::ok / std::error / std::some / std::none take their template arguments from
// context, like literals (spec 08).
import std;

enum io_error : u8 { closed, full }
enum other : u8 { x }

std::result<u32, io_error> from_return(bool c) {
    if (c) { return std::ok(5); }                                  // T from the return type
    return if (c) { std::ok(1u32) } else { std::error(io_error::full) };
}

void take(std::option<u8> o) {}

void inference() {
    std::option<u32> a = std::none;
    std::option<u32> b = std::some(7);
    std::option<std::option<u8>> nested = std::some(std::none);
    std::result<u32, io_error> c = std::error(io_error::closed);
    std::option<u32> d = default;                                  // std::none
    take(std::none);
    take(std::some(200));
    std::option<u32> e = std::option<u32>::some(1);                // written out in full
}

void errors() {
    auto a = std::none;                                            //~ error[E4001]: 'std::none' has no type
    auto b = std::ok(5u32);                                        //~ error[E4001]: 'std::ok(...)' has no type
    std::option<u32> c = std::some(5u64);                          //~ error[E4010]: expected 'std::option<u32>', found 'std::option<u64>'
    std::option<u8> d = std::some(300);                            //~ error[E4002]: 300 does not fit in 'u8'
    std::result<u32, io_error> e = std::error(other::x);           //~ error[E4010]: found 'std::result<?, other>'
    _ = std::none;                                                 //~ error[E4001]: 'std::none' has no type
    u8 f = std::some(1u8);                                         //~ error[E4010]: expected 'u8', found 'std::option<u8>'
    std::option<u32> h = std::option::none;                        //~ error[E4180]: 'option' takes 1 template argument, but 0 are given
}

void matches(std::result<u32, io_error> r) {
    match (r) {                                                    //~ error[E4060]: does not cover std::error
        std::ok(v) => {},
    }
}
