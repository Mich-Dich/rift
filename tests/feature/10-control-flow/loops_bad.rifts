// feature 10: break and continue only inside while/for (not across a lambda).
void f(u32 n) {
    break;                                   //~ error[E3030]
    while (n) {
        if (n) { break; }
        continue;
    }
    for (u32 i : 0..n) {
        auto g = []() { continue; };         //~ error[E3030]
    }
}
