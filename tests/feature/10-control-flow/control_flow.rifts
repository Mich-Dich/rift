void matching(u32 code, token t, employee e, std::result<u32, error> r) {
    std::str label = match (code) {
        200 => "ok",
        404 => "not_found",
        0..=99 => "low",
        x if x > 1000 => "huge",
        _   => "other",
    };
    match (parse_line(line)) {
        std::ok(e)    => employees.push(move e),
        std::error(_) => std::eprintln(f"skipping bad line: {line}"),
    }
    std::darray<employee> list = match (load(path)) {
        std::ok(l)    => move l,
        std::error(err) => {
            std::eprintln(f"error: {err}");
            return std::exit_code::failure;
        },
    };
    match (mut e) {
        employee{ .age = a, .. } => a,
    }
    match (c) {
        'a' => 1,
        -5 => 2,
        "text" => 3,
        true => 4,
    }
}
