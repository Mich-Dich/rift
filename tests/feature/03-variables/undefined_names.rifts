// feature 03: every name must be declared. (Types used as values: see 26-metaprogramming.)
struct point {
    f64 x = 0.0;
}

u32 compute(u32 input) {
    u32 result = inptu;                //~ error[E3020]: cannot find 'inptu'
    u32 early = later;                 //~ error[E3020]: cannot find 'later'
    u32 later = 1;
    pont p = default;                  //~ error[E3021]: cannot find type 'pont'
    compute x = 0;                     //~ error[E3022]: 'compute' is a function, not a type
    return missing(result);            //~ error[E3020]: cannot find 'missing'
}
