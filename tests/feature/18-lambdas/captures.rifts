// feature 18: a lambda can only use the locals it names in its capture list.
static u32 global_limit = 5;

void lambdas() {
    mut u32 counter = 0;
    u32 threshold = 10;
    auto ok1 = [threshold](u32 x) { return x + threshold + global_limit; };
    auto ok2 = [mut &counter]() { counter += 1; };
    auto ok3 = [step = 2u32](u32 x) { return x + step; };
    auto bad1 = [](u32 x) { return x + threshold; };        //~ error[E3050]: without capturing it
    auto bad2 = [thresold]() { };                           //~ error[E3020]: cannot capture 'thresold'
    auto nested = [threshold]() {
        auto inner = []() { return threshold; };            //~ error[E3050]
    };
}
